    {
      "title": "Ebola: Nigeria confirms new cases; Doctor dies in DR Congo; Saudi Arabia blocks Kenya",
      "source": "The Tanzania Times",
      "link": "https://tanzaniatimes.net/ebola-nigeria-confirms-new-cases-doctor-dies-in-dr-congo-saudi-arabia-blocks-kenya/",
      "date": "2026-10-31T16:31:14.000Z",
